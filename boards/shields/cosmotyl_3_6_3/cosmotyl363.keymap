#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  TAB   |  Q  |  W  |  E  |  R   |  T   |                   |  Y   |  U  |  I  |  O  |   P   |   -   |
            // |  SHIFT |  A  |  S  |  D  |  F   |  G   |                   |  H   |  J  |  K  |  L  |   ;   |   '   |
            // |  CTRL  |  Z  |  X  |  C  |  V   |  B   |                   |  N   |  M  |  ,  |  .  |   /   | SHIFT |
            //                |  [  |  ]  | GUI  | LOWER | SPACE |  | ENTER | RAISE| GUI |  [  |  ]  |

            bindings = <
                &kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                         &kp Y    &kp U   &kp I      &kp O     &kp P     &kp DASH
                &kp LSHIFT  &kp A   &kp S   &kp D     &kp F     &kp G                         &kp H    &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
                &kp LCTRL   &kp Z   &kp X   &kp C     &kp V     &kp B                         &kp N    &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHIFT
                                            &kp LALT  &kp LGUI  &mo 2   &kp SPACE    &kp RET  &mo 1   &kp BSPC   &kp RGUI
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  TAB   |  Q  |  W  |  E  |  R   |  T   |                   |  Y   |  U  |  I  |  O  |   P   |   -   |
            // |  SHIFT |  A  |  S  |  D  |  F   |  G   |                   |  H   |  J  |  K  |  L  |   ;   |   '   |
            // |  CTRL  |  Z  |  X  |  C  |  V   |  B   |                   |  N   |  M  |  ,  |  .  |   /   | SHIFT |
            //                |  [  |  ]  | GUI  | LOWER | SPACE |  | ENTER | RAISE| GUI |  [  |  ]  |

            bindings = <
                &kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                         &kp Y    &kp U   &kp I      &kp O     &kp P     &kp DASH
                &kp LSHIFT  &kp A   &kp S   &kp D     &kp F     &kp G                         &kp H    &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
                &kp LCTRL   &kp Z   &kp X   &kp C     &kp V     &kp B                         &kp N    &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHIFT
                                            &kp LALT  &kp LGUI  &mo 2   &kp SPACE    &kp RET  &mo 1   &kp BSPC   &kp RGUI
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  TAB   |  Q  |  W  |  E  |  R   |  T   |                   |  Y   |  U  |  I  |  O  |   P   |   -   |
            // |  SHIFT |  A  |  S  |  D  |  F   |  G   |                   |  H   |  J  |  K  |  L  |   ;   |   '   |
            // |  CTRL  |  Z  |  X  |  C  |  V   |  B   |                   |  N   |  M  |  ,  |  .  |   /   | SHIFT |
            //                |  [  |  ]  | GUI  | LOWER | SPACE |  | ENTER | RAISE| GUI |  [  |  ]  |

            bindings = <
                &kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                         &kp Y    &kp U   &kp I      &kp O     &kp P     &kp DASH
                &kp LSHIFT  &kp A   &kp S   &kp D     &kp F     &kp G                         &kp H    &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
                &kp LCTRL   &kp Z   &kp X   &kp C     &kp V     &kp B                         &kp N    &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHIFT
                                            &kp LALT  &kp LGUI  &mo 2   &kp SPACE    &kp RET  &mo 1   &kp BSPC   &kp RGUI
            >;
        };
    };
};
