#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                       &kp W             &kp E              &kp R         &kp T                      &kp Y  &kp U          &kp I      &kp O
&kp TAB         &kp Q  &kp S             &kp D              &kp F         &kp G                      &kp H  &kp J          &kp K      &kp L       &kp P          &kp DEL
&kp LEFT_SHIFT  &kp A  &kp X             &kp C              &kp V         &kp B                      &kp N  &kp M          &kp COMMA  &kp PERIOD  &kp SEMICOLON  &kp SQT
&kp LCTRL       &kp Z  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_GUI  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RIGHT_ALT  &trans     &trans      &kp SLASH      &kp ESCAPE
            >;
        };

        layer_1 {
            bindings = <
                        &trans      &trans      &trans  &trans                  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &trans      &trans      &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans      &trans      &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &bt BT_PRV  &bt BT_NXT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
                &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
