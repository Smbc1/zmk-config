#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                       &kp W             &kp E              &kp R         &kp T                      &kp Y  &kp U          &kp I      &kp O
&kp TAB         &kp Q  &kp S             &kp D              &kp F         &kp G                      &kp H  &kp J          &kp K      &kp L       &kp P          &kp DEL
&kp LEFT_SHIFT  &kp A  &kp X             &kp C              &kp V         &kp B                      &kp N  &kp M          &kp COMMA  &kp PERIOD  &kp SEMICOLON  &kp SQT
&kp LCTRL       &kp Z  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_GUI  &mo 1  &kp SPACE  &kp RET  &mo 1  &kp RIGHT_ALT  &trans     &trans      &kp SLASH      &kp ESCAPE
            >;
        };

        layer_1 {
            bindings = <
                              &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                  &kp NUMBER_6  &kp N7  &kp N8      &kp N9
&studio_unlock  &kp NUMBER_1  &trans        &trans        &trans        &trans                  &trans        &trans  &trans      &trans      &kp N0  &studio_unlock
&sys_reset      &trans        &trans        &trans        &trans        &trans                  &trans        &trans  &trans      &trans      &trans  &sys_reset
&bt BT_CLR_ALL  &trans        &bt BT_PRV    &bt BT_NXT    &trans        &trans  &trans  &trans  &trans        &trans  &bt BT_PRV  &bt BT_NXT  &trans  &bt BT_CLR_ALL
            >;
        };

        layer_2 {
            bindings = <
                                &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
                                &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
